  doi = {10.1093/oxfordhb/9780197618608.013.45},
  urldate = {2025-09-22},
  abstract = {Although primary education systems are a central feature of modern states, many students are not acquiring basic skills that improve productivity and social mobility. Looking at history can help explain this disconnection between schooling and learning. Social scientists have disagreed on whether education systems emerged mostly to promote skills or to mold political values and behaviors. They have also disagreed on whether educational expansion was a consequence of democratization and mass demand for social mobility, or an elite-driven process to advance industrialization, nation-building, or state-building goals. This chapter synthesizes recent historical political economy (HPE) studies on the origins, centralization, and expansion of primary education systems, and finds greater empirical support for nation- and state-building theories than for democratization or industrialization theories. While today education systems seek to promote skills for social mobility and economic growth, they are often constrained by institutional foundations that never intended to promote these goals.},
  isbn = {978-0-19-761860-8},
