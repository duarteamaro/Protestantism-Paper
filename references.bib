@article{doucetteCollapseStatePower2021,
  title = {The {{Collapse}} of {{State Power}}, the {{Cluniac Reform Movement}}, and the {{Origins}} of {{Urban Self-Government}} in {{Medieval Europe}}},
  author = {Doucette, Jonathan Stavnsk{\ae}r and M{\o}ller, J{\o}rgen},
  year = 2021,
